{
  "name": "ai-academic-compliance-system",
  "version": "2.0.0",
  "private": true,
  "description": "AI-driven academic compliance system (React + Tailwind frontend, PHP backend).",
  "workspaces": ["client"],
  "scripts": {
    "dev": "concurrently -n api,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "npm --workspace client run dev",
    "dev:server": "php -d upload_max_filesize=20M -d post_max_size=25M -S 127.0.0.1:4000 -t backend/public backend/public/index.php",
    "db:migrate": "php backend/bin/migrate.php",
    "build": "npm --workspace client run build",
    "lint": "npm --workspace client run lint"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
